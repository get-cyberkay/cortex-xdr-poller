# ===========================================================================
# Cortex XDR API credentials
# ===========================================================================
api_key=your_api_key_here
api_key_id=your_api_key_id_here
url=https://your-tenant.xdr.us.paloaltonetworks.com

# ===========================================================================
# API authentication type
#
#   standard  — (default) Authorization header = raw api_key value.
#               Use this when the key was generated as a "Standard" key in
#               the Cortex XDR console.
#
#   advanced  — Authorization header = SHA-256(api_key + nonce + timestamp).
#               A fresh nonce and timestamp are generated per request.
#               Use this when the key was generated as an "Advanced" key.
# ===========================================================================
API_AUTH_TYPE=standard

# ===========================================================================
# Poller behaviour
# ===========================================================================
POLL_INTERVAL_SECONDS=300

# First-run lookback. LOOKBACK_HOURS takes priority over LOOKBACK_DAYS.
# Defaults to 24 hours if neither is set. Accepts decimals (e.g. 1.5).
LOOKBACK_HOURS=
LOOKBACK_DAYS=1

STATE_FILE=./cortex_state.json

# ===========================================================================
# Output format
# Applies to both file output and syslog — they always use the same format.
#
#   leef  — LEEF 2.0  (default)  suited for IBM QRadar
#   cef   — CEF 0               suited for ArcSight, Splunk, most SIEMs
#   json  — JSON                 raw API record + _stream/_ingested metadata
# ===========================================================================
OUTPUT_FORMAT=leef

# ===========================================================================
# Output channels — enable/disable independently
# Both can be true simultaneously.
# ===========================================================================
ENABLE_FILE_LOG=true
ENABLE_SYSLOG=false

# ===========================================================================
# File log directories (used only when ENABLE_FILE_LOG=true)
# Rotation: daily midnight UTC + immediately at 100 MB, 30 files retained.
# ===========================================================================
LOG_DIR=./logs/alerts             # cortex_alerts.log
INCIDENTS_LOG_DIR=./logs/incidents      # cortex_incidents.log
AUDIT_MGMT_LOG_DIR=./logs/audit_mgmt   # cortex_mgmt_audit.log
AUDIT_AGENT_LOG_DIR=./logs/audit_agent # cortex_agent_audit.log
OPS_LOG_DIR=./logs/ops                 # cortex_ops.log (+ stderr always)

# ===========================================================================
# Syslog (used only when ENABLE_SYSLOG=true)
#
# All four streams → same host:port.
# Each stream uses a distinct RFC 5424 APP-NAME:
#   alerts       → cortex-alerts
#   incidents    → cortex-incidents
#   mgmt audits  → cortex-mgmt-audit
#   agent audits → cortex-agent-audit
# ===========================================================================
SYSLOG_HOST=
SYSLOG_PORT=514
SYSLOG_TRANSPORT=tcp      # tcp (default, persistent) or udp (stateless)
SYSLOG_TCP_FRAMING=newline # newline for line-based SIEMs; octet for RFC 6587 receivers
SYSLOG_FACILITY=16        # 16=local0 … 23=local7  (standard for security)



# ===========================================================================
# Display timezone
#
# Cortex XDR API timestamps are UTC epoch milliseconds. This setting
# controls how they are rendered in LEEF/CEF/JSON output and log messages.
# Specify the UTC offset in whole hours:
#   0  = UTC (default)
#   1  = WAT — West Africa Time  (Nigeria, Ghana, Cameroon, etc.)
#   2  = CAT — Central Africa Time
#   3  = EAT — East Africa Time
#  -5  = EST — Eastern Standard Time
# Example for Nigeria/Lagos: DISPLAY_TZ_OFFSET=1
# ===========================================================================
DISPLAY_TZ_OFFSET=0
# ===========================================================================
# HTTP request tuning
#
# REQUEST_TIMEOUT_SECONDS — seconds to wait for a response from the API.
#   Default 60. Increase if your network path involves a slow proxy or
#   high latency (the default 30s was too short for some environments).
#
# REQUEST_MAX_RETRIES — how many attempts per page before aborting a poll.
#   Default 3. Backoff between attempts: 1s, 2s, 4s, ...
#   Set to 1 to disable retries.
# ===========================================================================
REQUEST_TIMEOUT_SECONDS=60
REQUEST_MAX_RETRIES=3
# ===========================================================================
# Proxy (used only when USE_PROXY=true)
#
# Set USE_PROXY=true and provide at least PROXY_HTTPS.
# The proxy URL uses http:// scheme even for HTTPS traffic unless your
# proxy supports CONNECT over TLS (uncommon).
#
# Examples:
#   PROXY_HTTPS=http://proxy.corp.local:3128
#   PROXY_HTTPS=http://user:password@proxy.corp.local:3128
# ===========================================================================
USE_PROXY=false
PROXY_HTTP=
PROXY_HTTPS=

# ===========================================================================
# SSL verification (default: true)
#
# Set SSL_VERIFY=false only when connecting through a proxy that performs
# TLS inspection with a self-signed certificate and you cannot install the
# proxy CA cert on this host.
# WARNING: disabling SSL verification exposes the connection to
# man-in-the-middle attacks. Never use false in production.
# ===========================================================================
SSL_VERIFY=true
